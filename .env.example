# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Prisma & PostgreSQL Connection Strings (Dari Supabase Database Settings)
# Connection Pooling (Port 6543) untuk Prisma Query
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection (Port 5432) untuk Prisma Migrations / Introspection
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Midtrans Payment Gateway Configuration (Customer Payment Collection - SOLE GATEWAY)
# Server Key (JANGAN PERNAH diekspos ke frontend / client)
MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key-here"
# Client Key (Digunakan di frontend untuk Midtrans Snap SDK)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key-here"
# Environment Mode: false = Sandbox (Default/Testing), true = Production (Live)
MIDTRANS_IS_PRODUCTION=false
# Midtrans Iris Automated Payouts / Disbursements API Key (Opsional - default menggunakan MIDTRANS_SERVER_KEY)
MIDTRANS_IRIS_KEY="IRIS-your-iris-api-key-here"

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [DEPRECATED - DO NOT USE FOR NEW TRANSACTIONS] Legacy Payment Gateway Keys (Tripay & Xendit)
# TRIPAY_ENV=sandbox
# TRIPAY_API_KEY=
# TRIPAY_PRIVATE_KEY=
# TRIPAY_MERCHANT_CODE=
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_VERIFICATION_TOKEN=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Authentication (Access Token & Refresh Token)
JWT_SECRET=your-cryptographically-secure-random-64-character-hex-jwt-access-secret
JWT_REFRESH_SECRET=your-cryptographically-secure-random-64-character-hex-jwt-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

