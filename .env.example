# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Prisma & PostgreSQL Connection Strings (Dari Supabase Database Settings)
# Connection Pooling (Port 6543) untuk Prisma Query
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Connection (Port 5432) untuk Prisma Migrations / Introspection
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Xendit Sandbox Configuration
XENDIT_SECRET_KEY=xnd_development_your_sandbox_secret_key_here
XENDIT_WEBHOOK_VERIFICATION_TOKEN=your_webhook_verification_token_here
NEXT_PUBLIC_XENDIT_PUBLIC_KEY=xnd_public_development_your_key_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tripay Payment Gateway Configuration (Customer Payment Collection)
# Mode: "sandbox" (testing) atau "production" (live)
TRIPAY_ENV=sandbox
TRIPAY_API_KEY=DEV-your-tripay-api-key-here
TRIPAY_PRIVATE_KEY=your-tripay-private-key-here
TRIPAY_MERCHANT_CODE=T12345

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Authentication (Access Token & Refresh Token)
JWT_SECRET=your-jwt-access-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

